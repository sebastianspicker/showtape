{
  "name": "showtape",
  "version": "0.3.0-alpha.1",
  "description": "Network-only web application for turning one setlist.fm setlist into an Apple Music playlist.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastianspicker/showtape.git"
  },
  "scripts": {
    "build": "next build && node scripts/generate-csp-manifest.mjs",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint src tests scripts demo next.config.ts playwright.config.ts --max-warnings=0",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:build": "node scripts/build-pages-demo.mjs",
    "demo:check": "node scripts/build-pages-demo.mjs --check",
    "screenshots": "node scripts/capture-demo-screenshots.mjs",
    "hygiene:check": "node scripts/check-public-boundary.mjs",
    "audit:security": "pnpm audit --audit-level=moderate --prod",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "jose": "^6.2.2",
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "pnpm@9.15.3",
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^29.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "esbuild@<0.25.0": "0.25.0",
      "flatted@<3.4.2": "3.4.2",
      "js-yaml@<4.3.1": "4.3.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "nanoid": "3.3.18",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "8.5.23",
      "rollup@<4.59.0": "4.59.0",
      "sharp@<0.35.4": "0.35.4",
      "undici@<7.29.0": "7.29.0",
      "vite@<6.4.3": "6.4.3"
    }
  }
}
