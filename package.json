{
  "name": "showtape",
  "version": "0.3.0-alpha.1",
  "description": "Network-only web application for turning one setlist.fm setlist into an Apple Music playlist.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastianspicker/showtape.git"
  },
  "scripts": {
    "build": "corepack pnpm@9.15.3 -r run build",
    "dev": "corepack pnpm@9.15.3 --filter web run dev",
    "lint": "corepack pnpm@9.15.3 -r run lint",
    "typecheck": "corepack pnpm@9.15.3 --filter @repo/shared run build && corepack pnpm@9.15.3 --filter @repo/core run build && corepack pnpm@9.15.3 --filter @repo/api run build && corepack pnpm@9.15.3 --filter web exec tsc --noEmit",
    "test": "corepack pnpm@9.15.3 -r run test",
    "demo:build": "node scripts/build-pages-demo.mjs",
    "demo:check": "node scripts/build-pages-demo.mjs --check",
    "bundle:report": "node scripts/web-bundle-report.mjs",
    "diagnostics:export": "tsx scripts/support-diagnostics.ts",
    "fixtures:seed": "tsx scripts/seed-demo-setlist-fixtures.ts",
    "hygiene:check": "node scripts/check-public-boundary.mjs",
    "audit:security": "corepack pnpm@9.15.3 audit --audit-level=moderate --prod",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "cleanup:repo": "bash scripts/cleanup-repo.sh"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "esbuild@<0.25.0": "0.25.0",
      "flatted@<3.4.2": "3.4.2",
      "js-yaml@<4.3.1": "4.3.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "nanoid": "3.3.18",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "8.5.23",
      "rollup@<4.59.0": "4.59.0",
      "sharp": "0.35.0",
      "undici@<7.29.0": "7.29.0",
      "vite@<6.4.3": "6.4.3"
    }
  },
  "packageManager": "pnpm@9.15.3",
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
